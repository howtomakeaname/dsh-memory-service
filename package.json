{
  "name": "dsh-memory-service",
  "version": "0.3.1",
  "type": "module",
  "description": "File-native long-term memory for DeepSeek Harness, with Claude Code memory import/export and a rebuildable SQLite index.",
  "license": "MIT",
  "bin": {
    "dsh-memory": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/plugin.mjs",
    "./core": "./src/index.mjs",
    "./store": "./src/store.mjs",
    "./claude": "./src/adapters/claude.mjs",
    "./client": "./client.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "INSTALL.md",
    "docs",
    "bench",
    "client.js",
    "CHANGELOG.md",
    "screenshots.json"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "e2e": "node scripts/e2e-real.mjs --profile bench-memt-headless",
    "bench:e2e": "node bench/e2e/run.mjs",
    "e2e:extraction": "node scripts/e2e-pure-extraction.mjs --profile bench-memt-headless",
    "prepublishOnly": "npm test && npm run check",
    "e2e:profile": "node scripts/e2e-profile.mjs --profile bench-memt-headless",
    "e2e:preference": "node scripts/e2e-preference-extraction.mjs --profile bench-memt-headless"
  },
  "engines": {
    "node": ">=22.5"
  },
  "main": "src/plugin.mjs",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howtomakeaname/dsh-memory-service.git"
  },
  "homepage": "https://github.com/howtomakeaname/dsh-memory-service#readme",
  "bugs": {
    "url": "https://github.com/howtomakeaname/dsh-memory-service/issues"
  }
}
